<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <!-- Glow Dot -->
    <ImageView
        android:id="@+id/glow_dot"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/splash_glow_dot"
        android:layout_centerInParent="true"
        android:alpha="0" />

    <!-- Rings -->
    <ImageView
        android:id="@+id/ring1"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:src="@drawable/splash_ring"
        android:layout_centerInParent="true" />

    <ImageView
        android:id="@+id/ring2"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:src="@drawable/splash_ring"
        android:layout_centerInParent="true" />

    <ImageView
        android:id="@+id/ring3"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:src="@drawable/splash_ring"
        android:layout_centerInParent="true" />

    <!-- Content Container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_centerInParent="true">

        <TextView
            android:id="@+id/logo_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ABL"
            android:textSize="90sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:alpha="0" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="SOFTWARE SOLUTIONS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:alpha="0" />

        <View
            android:id="@+id/divider"
            android:layout_width="260dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/splash_divider" />

        <TextView
            android:id="@+id/services"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="PAYROLL • ACCOUNTING • SALES • MARKETING"
            android:textColor="#d8e6f5"
            android:textSize="11sp"
            android:letterSpacing="0.03"
            android:alpha="0" />
    </LinearLayout>

</RelativeLayout>
